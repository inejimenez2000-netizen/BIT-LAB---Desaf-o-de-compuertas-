<footer class="footer">BITLAB · Proyecto 13: Compuertas lógicas · Matemáticas Discretas · Xperience<br>Herramienta educativa de alcance introductorio. Verifica el contenido y documenta el proceso real del equipo.</footer>
</div>
<script>
const $=id=>document.getElementById(id);
let A=0,B=0,score=0,done=0,streak=0,idx=0,answered=false,playerName="";
const questions=[
{g:"AND",a:1,b:1,ask:"El sistema solo activa la alarma si los dos sensores detectan movimiento. A=1 y B=1. ¿Cuál es la salida?",opts:[0,1],why:"AND exige que ambas entradas sean 1. Como A=1 y B=1, la salida es 1."},
{g:"AND",a:1,b:0,ask:"Un sensor detecta movimiento (1), el otro no (0). La regla es AND. ¿Salida?",opts:[0,1],why:"En AND basta con que una entrada sea 0 para que la salida sea 0. Aquí 1 ∧ 0 = 0."},
{g:"OR",a:0,b:1,ask:"Una puerta se abre si se activa cualquiera de dos botones. A=0, B=1. ¿Salida OR?",opts:[0,1],why:"OR devuelve 1 cuando al menos una entrada es 1. B=1, así que 0 ∨ 1 = 1."},
{g:"OR",a:0,b:0,ask:"Ninguno de los dos botones está presionado. ¿Qué entrega OR?",opts:[0,1],why:"OR solo produce 0 cuando ambas entradas son 0. Por eso 0 ∨ 0 = 0."},
{g:"NOT",a:0,b:0,ask:"Un sistema invierte el estado de A. Si A=0, ¿qué salida entrega NOT?",opts:[0,1],why:"NOT invierte el valor: ¬0 = 1. La entrada B no interviene."},
{g:"NOT",a:1,b:0,ask:"El sensor A está activo (1). El circuito aplica NOT. ¿Salida?",opts:[0,1],why:"NOT cambia 1 por 0. Por tanto ¬1 = 0."},
{g:"AND",a:1,b:1,ask:"Dos condiciones deben cumplirse simultáneamente. A=1 y B=1. ¿Cuál es la expresión y salida?",opts:[0,1],why:"La expresión es A ∧ B. Ambas condiciones son verdaderas, por eso la salida es 1."},
{g:"OR",a:1,b:1,ask:"Dos rutas alternativas están disponibles. A=1, B=1. ¿Salida OR inclusivo?",opts:[0,1],why:"OR inclusivo devuelve 1 si una o ambas entradas son 1. Con 1 y 1 la salida es 1."},
{g:"AND",a:0,b:1,ask:"Un circuito AND recibe A=0 y B=1. ¿Qué fila de la tabla de verdad corresponde?",opts:[0,1],why:"La fila (0,1) de AND produce 0. La condición de que ambas sean 1 no se cumple."},
{g:"OR",a:1,b:0,ask:"Reto final: A=1, B=0 y compuerta OR. Calcula la salida.",opts:[0,1],why:"Al menos una entrada es 1; entonces 1 ∨ 0 = 1."}
];
function bool(g,a,b){if(g==="AND")return a&b;if(g==="OR")return a|b;return 1-a}
function show(id){document.querySelectorAll(".section").forEach(s=>s.classList.toggle("active",s.id===id));document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.tab===id));window.scrollTo({top:document.querySelector(".nav").offsetTop-8,behavior:"smooth"})}
function startGame(){playerName=$("player").value.trim()||"Estratega";$("player").value=playerName;show("play");renderQuestion()}
function renderQuestion(){answered=false;let q=questions[idx];$("missionLabel").textContent=`Misión ${idx+1} de ${questions.length} · ${playerName}`;$("difficulty").textContent=idx<3?"INICIACIÓN":idx<7?"INTERMEDIO":"DESAFÍO";$("bar").style.width=(idx/questions.length*100)+"%";$("qText").textContent=q.ask;$("qHint").textContent=`Pista: identifica la regla de ${q.g}. No respondas al azar: calcula la operación.`;$("answers").innerHTML=q.opts.map(v=>`<button class="answer" onclick="answer(${v})">Salida = ${v}</button>`).join("");$("qFeedback").className="feedback";$("qFeedback").textContent="";$("nextBtn").disabled=true;$("nextBtn").textContent=idx===questions.length-1?"Ver resultado final →":"Siguiente misión →"}
function answer(v){if(answered)return;answered=true;let q=questions[idx],correct=bool(q.g,q.a,q.b),ok=v===correct;if(ok){score+=100+(streak*10);done++;streak++}else{streak=0}updateStats();$("qFeedback").className="feedback "+(ok?"good":"bad");$("qFeedback").innerHTML=`<b>${ok?"¡Excelente, "+playerName+"! +XP":"Todavía no. ¡Aprender también es corregir!"}</b><br>${q.why}<br><span class="small">Operación: ${q.g==="AND"?q.a+" ∧ "+q.b:q.g==="OR"?q.a+" ∨ "+q.b:"¬"+q.a} = ${correct}</span>`;$("nextBtn").disabled=false;document.querySelectorAll(".answer").forEach(b=>b.disabled=true)}
function nextQuestion(){if(!answered)return;if(idx===questions.length-1){$("qText").textContent=`¡Recorrido terminado, ${playerName}!`; $("answers").innerHTML=`<div class="output" style="grid-column:1/-1"><strong>${score} XP</strong><span>Misiones correctas: ${done} de 10</span></div>`;$("qFeedback").className="feedback good";$("qFeedback").textContent="Revisa las explicaciones, practica en el laboratorio y vuelve a intentarlo para mejorar tu dominio."; $("nextBtn").disabled=true;$("bar").style.width="100%";return}idx++;renderQuestion()}
function resetGame(){idx=0;score=0;done=0;streak=0;updateStats();renderQuestion()}
function updateStats(){$("score").textContent=score+" XP";$("done").textContent=done+" / 10";$("streak").textContent=streak+" 🔥";$("rank").textContent=score>=700?"MAESTRO":score>=300?"EXPLORADOR":"NOVATO"}
function setInput(which,val){if(which==="A")A=val;else B=val;["a0","a1","b0","b1"].forEach(id=>$(id).classList.remove("on"));$("a"+A).classList.add("on");$("b"+B).classList.add("on");evaluateLab()}
function evaluateLab(){let g=$("gateSelect").value,y=bool(g,A,B);$("nodeA").textContent="A = "+A;$("nodeB").textContent=g==="NOT"?"B = —":"B = "+B;$("nodeGate").textContent=g;$("nodeOut").textContent="SALIDA = "+y;$("labOutput").textContent=y;$("labExpression").textContent=g==="AND"?`${A} ∧ ${B} = ${y}`:g==="OR"?`${A} ∨ ${B} = ${y}`:`¬${A} = ${y}`;let s=g==="AND"?[`Se leen las entradas A=${A} y B=${B}.`,`La regla AND exige que las dos entradas sean 1.`,`¿A=1 y B=1? ${A===1&&B===1?"Sí":"No"}.`,`La salida calculada es ${y}.`]:g==="OR"?[`Se leen las entradas A=${A} y B=${B}.`,`La regla OR exige que al menos una entrada sea 1.`,`¿A=1 o B=1? ${A===1||B===1?"Sí":"No"}.`,`La salida calculada es ${y}.`]:[`Se lee la entrada A=${A}.`,`NOT invierte el valor binario recibido.`,`Se calcula 1 − ${A}.`,`La salida calculada es ${y}; B no participa en NOT.`];$("labSteps").innerHTML=s.map(x=>`<li>${x}</li>`).join("")}
function compare(){let g1=$("gA").value,a1=+$("aA").value,b1=+$("bA").value,g2=$("gB").value,a2=+$("aB").value,b2=+$("bB").value,y1=bool(g1,a1,b1),y2=bool(g2,a2,b2);let changes=[];if(g1!==g2)changes.push("la compuerta");if(a1!==a2)changes.push("la entrada A");if(g1!=="NOT"&&g2!=="NOT"&&b1!==b2)changes.push("la entrada B");let diff=changes.length?changes.join(", "):"ningún parámetro";$("comparison").classList.remove("hidden");$("comparison").innerHTML=`<div class="grid"><div class="output"><b>ESCENARIO A</b><strong>${y1}</strong><span>${g1}(${a1}, ${b1})</span></div><div class="output"><b>ESCENARIO B</b><strong>${y2}</strong><span>${g2}(${a2}, ${b2})</span></div></div><h3 style="margin-top:18px">Interpretación</h3><p>Entre A y B cambian: <b>${diff}</b>. La salida ${y1===y2?"se mantiene en "+y1:"pasa de "+y1+" a "+y2}. Esto ocurre porque cada compuerta aplica una regla booleana distinta a sus entradas. Para una comparación controlada, cambia solo un parámetro a la vez.</p>`}
function runValidation(){let y=bool("OR",1,0),el=$("validationResult");el.className="feedback "+(y===1?"good":"bad");el.innerHTML=`Resultado de BITLAB: <b>${y}</b>. Resultado manual esperado: <b>1</b>. ${y===1?"Coinciden: la validación fue satisfactoria.":"No coinciden: revisa el algoritmo antes de entregar."}`}
function quickCheck(){$("quick").style.display="block";$("quick").innerHTML="<b>AND:</b> 1 ∧ 0 = 0 (no se cumplen las dos entradas).<br><b>OR:</b> 1 ∨ 0 = 1 (al menos una entrada es 1).<br><b>NOT:</b> ¬1 = 0 (invierte A; B no se usa)."}
evaluateLab();updateStats();
</script></body></html>
